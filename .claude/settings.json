{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/quality/agents/stop_hook.py\" --scope worktree",
            "timeout": 600,
            "statusMessage": "Running repository quality checks"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/quality/agents/stop_hook.py\" --scope worktree",
            "timeout": 600,
            "statusMessage": "Running repository quality checks"
          }
        ]
      }
    ]
  }
}
